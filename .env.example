# https://www.last.fm/api/account/create で取得した API Key
LASTFM_API_KEY=
# 視聴履歴を検証するLast.fmユーザー名
LASTFM_USERNAME=

# SupabaseプロジェクトのURL（Project Settings > API）
NEXT_PUBLIC_SUPABASE_URL=
# Supabaseプロジェクトのanon key（ブラウザで使用、公開前提のキー）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabaseプロジェクトのservice role key（サーバー専用。絶対にクライアントへ公開しない）
SUPABASE_SERVICE_ROLE_KEY=
